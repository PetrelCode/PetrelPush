<Window x:Class="PetrelPush.App.QuickAccessPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="快速入口" Width="380" SizeToContent="Height" MaxHeight="420"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" ResizeMode="NoResize" WindowStartupLocation="Manual"
        FontFamily="Microsoft YaHei UI, Segoe UI"
        UseLayoutRounding="True" SnapsToDevicePixels="True">

    <!--
      顶栏按钮下方弹出的浮层：没有标题栏，位置由 TerminalWindow 贴住按钮计算。
      之所以仍然是一个无边框窗口而不是 Popup / 面板，是因为 WebView2 是 HWND 宿主控件，
      同区域的 WPF 浮层会被遮挡；面板靠布局撑开又会把终端内容往下挤。
    -->
    <Window.Resources>
        <!-- 整行可点的条目：悬停时只提亮背景，避免整块高亮抢走终端本身的注意力 -->
        <Style x:Key="PickerRowButton" TargetType="Button">
            <Setter Property="Foreground" Value="#E6E1F5" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome" Background="{TemplateBinding Background}"
                                CornerRadius="6" Padding="9,6">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#2A2640" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#332C4A" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 行尾的 ✕：只有路径模式会显示，颜色比正文更淡，避免抢走整行点击的注意力 -->
        <Style x:Key="PickerRemoveButton" TargetType="Button" BasedOn="{StaticResource PickerRowButton}">
            <Setter Property="Foreground" Value="#8E87A3" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Width" Value="26" />
            <Setter Property="Height" Value="26" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <!-- 底部「添加路径」：浮层里最轻的一档文字按钮 -->
        <Style x:Key="PickerActionButton" TargetType="Button">
            <Setter Property="Foreground" Value="#B9AEE0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Padding" Value="6,4" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome" Background="{TemplateBinding Background}"
                                CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#332C4A" />
                                <Setter Property="Foreground" Value="#E6E1F5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- 外圈留 8px 给投影，视觉上才像"浮"在终端上 -->
    <Border Margin="8" Background="#1F1F2E" BorderBrush="#3B3550" BorderThickness="1"
            CornerRadius="10" Padding="4,8,4,6">
        <Border.Effect>
            <DropShadowEffect BlurRadius="16" ShadowDepth="2" Opacity="0.5" Color="#000000" />
        </Border.Effect>

        <StackPanel>
            <TextBlock x:Name="HintText" Foreground="#8E87A3" FontSize="11"
                       Margin="8,0,8,6" TextWrapping="Wrap"
                       Text="点一条把命令填进终端输入行，不会自动回车。" />

            <TextBlock x:Name="EmptyText" Foreground="#6E6780" FontSize="11"
                       Margin="8,2,8,6" TextWrapping="Wrap" Visibility="Collapsed" />

            <ScrollViewer MaxHeight="290" VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <ItemsControl x:Name="ItemList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Button Grid.Column="0" Style="{StaticResource PickerRowButton}"
                                        Tag="{Binding}" Click="OnPickRow">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Title}"
                                                   Visibility="{Binding TitleVisibility}"
                                                   FontSize="12" FontWeight="SemiBold"
                                                   Foreground="#E6E1F5"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding Detail}"
                                                   Visibility="{Binding DetailVisibility}"
                                                   FontFamily="{StaticResource MonoFont}" FontSize="11"
                                                   Foreground="#8E87A3" Margin="0,2,0,0"
                                                   TextTrimming="CharacterEllipsis"
                                                   ToolTip="{Binding Detail}" />
                                    </StackPanel>
                                </Button>
                                <Button Grid.Column="1" Content="✕" Style="{StaticResource PickerRemoveButton}"
                                        Tag="{Binding}" Visibility="{Binding RemoveVisibility}"
                                        ToolTip="移除这一条" Margin="2,0,6,0" Click="OnRemoveRow" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <Button x:Name="AddPathButton" Content="＋ 添加路径" HorizontalAlignment="Left"
                    Style="{StaticResource PickerActionButton}" Margin="6,4,0,0"
                    Visibility="Collapsed" Click="OnAddPath" />
        </StackPanel>
    </Border>
</Window>
