<Window x:Class="PetrelPush.App.TerminalWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="终端" Height="600" Width="960"
        MinHeight="320" MinWidth="560"
        WindowStartupLocation="CenterScreen"
        Background="#1B1B26"
        FontFamily="Microsoft YaHei UI, Segoe UI"
        UseLayoutRounding="True">

    <!--
      刻意不设 Owner（打开方见 MainWindow.ShowTerminalWindow）：带 Owner 的窗口在主窗口最小化时
      会被系统连带隐藏，而终端往往要在主窗口收起后继续用。位置由打开方手动居中到主窗口，
      CenterScreen 只是没人指定位置时的兜底。
    -->
    <Window.Resources>
        <!--
            顶栏的快速入口按钮：深色，与状态条同色系。
            点开的是贴在按钮下方弹出的浮层（QuickAccessPickerWindow，无边框独立窗口）——
            WebView2 是 HWND 宿主控件，同区域的 WPF 浮层会被遮挡，
            靠布局撑开的面板又会把终端内容往下挤。
        -->
        <Style x:Key="QuickEntryButton" TargetType="Button">
            <Setter Property="Foreground" Value="#C9C3DC" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Padding" Value="10,3" />
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome" Background="Transparent" BorderBrush="#3B3550"
                                BorderThickness="1" CornerRadius="7" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#332C4A" />
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="#5B4F7A" />
                                <Setter Property="Foreground" Value="#E6E1F5" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#4A3568" />
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="#9254DE" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 顶部状态条：主机与会话状态 + 快速命令 / 快速路径入口 -->
        <Border Grid.Row="0" Background="#232334" Padding="14,8"
                BorderBrush="#2F2B40" BorderThickness="0,0,0,1">
            <DockPanel LastChildFill="False">
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                    <Ellipse x:Name="StatusDot" Width="8" Height="8" Margin="0,0,8,0"
                             VerticalAlignment="Center" Fill="#B7791F" />
                    <TextBlock x:Name="TargetText" Foreground="#E6E1F5"
                               FontSize="12" FontWeight="SemiBold" Text="—" />
                    <TextBlock x:Name="PathText" Foreground="#8E87A3" FontSize="11"
                               Margin="10,0,0,0" TextTrimming="CharacterEllipsis"
                               MaxWidth="320"
                               ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
                </StackPanel>
                <TextBlock x:Name="StatusText" DockPanel.Dock="Right" Foreground="#8E87A3"
                           FontSize="11" VerticalAlignment="Center" Text="正在准备…" />
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="0,0,12,0"
                            VerticalAlignment="Center">
                    <Button Content="快速命令" Style="{StaticResource QuickEntryButton}"
                            ToolTip="在按钮下方列出已保存的命令，点一条只填到终端输入行，按回车才执行"
                            Click="OnOpenQuickCommands" />
                    <Button Content="快速路径" Style="{StaticResource QuickEntryButton}"
                            ToolTip="在按钮下方列出已保存的目录，点一条把 cd 命令填到终端输入行"
                            Click="OnOpenQuickPaths" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!--
            终端渲染层。注意：WebView2 是 HWND 宿主控件（HwndHost），永远绘制在所有 WPF 元素之上，
            任何覆盖在它上面的 WPF 元素（含同一 Grid 中的 Border）都会被遮挡。
            因此连接状态与错误提示统一写入终端内容区（由 xterm.js 渲染），不使用 WPF 覆盖层。
        -->
        <wv2:WebView2 Grid.Row="1" x:Name="TerminalView" />
    </Grid>
</Window>
