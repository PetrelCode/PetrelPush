<Window x:Class="PetrelPush.App.TextInputWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="输入名称" Width="440" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="{StaticResource PageBackgroundBrush}"
        FontFamily="Microsoft YaHei UI, Segoe UI"
        UseLayoutRounding="True">

    <Border Style="{StaticResource Card}" Margin="14">
        <StackPanel>
            <TextBlock x:Name="TitleText" Style="{StaticResource CardTitle}" Text="输入名称" />
            <TextBlock x:Name="HintText" Style="{StaticResource FieldLabel}" Margin="0,6,0,6"
                       Text="名称" TextWrapping="Wrap" />
            <TextBox x:Name="InputBox" MinHeight="32" />
            <TextBlock x:Name="ErrorText" FontSize="11" Margin="0,6,0,0" TextWrapping="Wrap"
                       Foreground="{StaticResource StateErrorBrush}" Visibility="Collapsed" />

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                <Button Content="取消" Style="{StaticResource SecondaryButton}"
                        MinWidth="84" IsCancel="True" />
                <Button Content="确定" Style="{StaticResource PrimaryButton}"
                        MinWidth="84" Margin="8,0,0,0" IsDefault="True" Click="OnConfirm" />
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
