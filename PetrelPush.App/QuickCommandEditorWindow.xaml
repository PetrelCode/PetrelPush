<Window x:Class="PetrelPush.App.QuickCommandEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="快速命令" Width="520" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="{StaticResource PageBackgroundBrush}"
        FontFamily="Microsoft YaHei UI, Segoe UI"
        UseLayoutRounding="True">

    <!--
      弹窗本身就是一个小面板，不再套 Card 边框：窗口底色已经是页面底色，
      再叠一层卡片只会出现"卡片里的卡片"和与标题栏重复的标题。
    -->
    <StackPanel Margin="22,18,22,18">
        <TextBlock Style="{StaticResource CardHint}" TextWrapping="Wrap"
                   Text="只保存到这里，不会自动执行；终端里点条目时会填进输入行，按回车才运行。" />

        <TextBlock Text="名称" Style="{StaticResource FieldLabel}" Margin="0,16,0,6" />
        <TextBox x:Name="NameBox" MinHeight="32" />

        <TextBlock Text="命令" Style="{StaticResource FieldLabel}" Margin="0,12,0,6" />
        <TextBox x:Name="CommandBox" MinHeight="32" FontFamily="{StaticResource MonoFont}" />

        <TextBlock x:Name="ErrorText" FontSize="11" Margin="0,6,0,0" TextWrapping="Wrap"
                   Foreground="{StaticResource StateErrorBrush}" Visibility="Collapsed" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button Content="取消" Style="{StaticResource SecondaryButton}"
                    MinWidth="84" IsCancel="True" />
            <Button Content="保存" Style="{StaticResource PrimaryButton}"
                    MinWidth="84" Margin="8,0,0,0" IsDefault="True" Click="OnConfirm" />
        </StackPanel>
    </StackPanel>
</Window>
