<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>disable</ImplicitUsings>
    <RootNamespace>PetrelPush.App</RootNamespace>
    <AssemblyName>PetrelPush</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\icon.ico</ApplicationIcon>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <!-- WPF 的 PerMonitorV2 依赖 manifest 中的 dpiAware/dpiAwareness（WinForms 分析器建议不适用于此混合项目） -->
    <NoWarn>$(NoWarn);WFAC010</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- 顶栏与「关于」页使用的品牌图标（WPF 资源，URI：/Assets/icon.png） -->
    <Resource Include="Assets\icon.png" />
  </ItemGroup>

  <ItemGroup>
    <!-- 终端渲染层：xterm.js 离线资源，由 WebView2 通过虚拟主机映射加载，不走 CDN -->
    <None Update="Terminal\wwwroot\**\*"
          CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4314.35" />
    <PackageReference Include="Serilog" Version="4.1.0" />
    <PackageReference Include="Serilog.Sinks.File" Version="6.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\PetrelPush.Core\PetrelPush.Core.csproj" />
    <ProjectReference Include="..\PetrelPush.State\PetrelPush.State.csproj" />
    <ProjectReference Include="..\PetrelPush.Transport\PetrelPush.Transport.csproj" />
  </ItemGroup>

</Project>
