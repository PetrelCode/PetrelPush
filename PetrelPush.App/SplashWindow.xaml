<Window x:Class="PetrelPush.App.SplashWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PetrelPush"
        Width="420" Height="240"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource PageBackgroundBrush}"
        FontFamily="Microsoft YaHei UI, Segoe UI"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display">

    <Window.Resources>
        <!-- 对应 splash.ts 的 fade-in / fade-up / track-slide 关键帧与延迟 -->
        <Storyboard x:Key="SplashStoryboard">
            <DoubleAnimation Storyboard.TargetName="BrandPanel"
                             Storyboard.TargetProperty="Opacity"
                             From="0" To="1" Duration="0:0:0.4">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>

            <DoubleAnimation Storyboard.TargetName="NameText"
                             Storyboard.TargetProperty="Opacity"
                             From="0" To="1" Duration="0:0:0.45" BeginTime="0:0:0.05">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="NameTransform"
                             Storyboard.TargetProperty="Y"
                             From="6" To="0" Duration="0:0:0.45" BeginTime="0:0:0.05">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>

            <DoubleAnimation Storyboard.TargetName="EditionBorder"
                             Storyboard.TargetProperty="Opacity"
                             From="0" To="1" Duration="0:0:0.45" BeginTime="0:0:0.12">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="EditionTransform"
                             Storyboard.TargetProperty="Y"
                             From="6" To="0" Duration="0:0:0.45" BeginTime="0:0:0.12">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>

            <DoubleAnimation Storyboard.TargetName="TrackBorder"
                             Storyboard.TargetProperty="Opacity"
                             From="0" To="1" Duration="0:0:0.4" BeginTime="0:0:0.24">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>

            <DoubleAnimation Storyboard.TargetName="HintText"
                             Storyboard.TargetProperty="Opacity"
                             From="0" To="1" Duration="0:0:0.4" BeginTime="0:0:0.3">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>

            <!-- 轨道宽度 168、滑块宽 42%，对应 -105% → 340% -->
            <DoubleAnimation Storyboard.TargetName="FillTransform"
                             Storyboard.TargetProperty="X"
                             From="-74.088" To="239.904" Duration="0:0:1.4"
                             RepeatBehavior="Forever">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseInOut" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>
    </Window.Resources>

    <Grid>
        <Grid.Background>
            <!-- 顶部一层淡紫晕开，与主界面底色（#F4F2F8）衔接 -->
            <RadialGradientBrush Center="0.5,0" GradientOrigin="0.5,0" RadiusX="1.2" RadiusY="1.1">
                <GradientStop Color="#F4ECFD" Offset="0" />
                <GradientStop Color="#F4F2F8" Offset="0.62" />
                <GradientStop Color="#F4F2F8" Offset="1" />
            </RadialGradientBrush>
        </Grid.Background>

        <!-- 左上角品牌 -->
        <StackPanel x:Name="BrandPanel" Orientation="Horizontal"
                    HorizontalAlignment="Left" VerticalAlignment="Top"
                    Margin="20,16,0,0" Opacity="0">
            <Viewbox Width="20" Height="20">
                <Canvas Width="28" Height="28">
                    <Border Width="28" Height="28" CornerRadius="8" Background="{StaticResource BrandBrush}" />
                    <Path Stroke="#FFFFFF" StrokeThickness="2"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                          Data="M7,15 C10,10 13.5,8.5 15,12 C16.5,8.5 20,10 23,15" />
                    <Path Stroke="#FFFFFF" StrokeThickness="1.6"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                          Data="M15,12 q0.4,3 2.4,4.6" />
                </Canvas>
            </Viewbox>
            <TextBlock Text="PetrelCode" FontSize="13" FontWeight="SemiBold"
                       Foreground="{StaticResource TextPrimaryBrush}" Margin="8,0,0,0" VerticalAlignment="Center" />
        </StackPanel>

        <!-- 中央：产品名 + 版本徽标 -->
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
            <TextBlock x:Name="NameText" Text="PetrelPush"
                       FontFamily="{StaticResource DisplayFont}"
                       FontSize="26" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"
                       HorizontalAlignment="Center" Opacity="0">
                <TextBlock.RenderTransform>
                    <TranslateTransform x:Name="NameTransform" Y="6" />
                </TextBlock.RenderTransform>
            </TextBlock>

            <Border x:Name="EditionBorder"
                    Background="{StaticResource BrandSoftBrush}" BorderBrush="{StaticResource BrandBorderBrush}"
                    BorderThickness="1" Height="22" CornerRadius="11" Padding="9,0" Margin="0,8,0,0"
                    HorizontalAlignment="Center" Opacity="0">
                <Border.RenderTransform>
                    <TranslateTransform x:Name="EditionTransform" Y="6" />
                </Border.RenderTransform>
                <TextBlock x:Name="VersionBadge" Text="v0.4.0"
                           FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource BrandBrush}" />
            </Border>
        </StackPanel>

        <!-- 底部：进度条 + 提示 -->
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,24">
            <Border x:Name="TrackBorder" Width="168" Height="4" CornerRadius="2"
                    Background="{StaticResource TrackBrush}" ClipToBounds="True" Opacity="0">
                <Border Width="70.56" Height="4" CornerRadius="2" HorizontalAlignment="Left">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Color="#6D3FD1" Offset="0" />
                            <GradientStop Color="#5B2FC4" Offset="1" />
                        </LinearGradientBrush>
                    </Border.Background>
                    <Border.RenderTransform>
                        <TranslateTransform x:Name="FillTransform" X="-74.088" />
                    </Border.RenderTransform>
                </Border>
            </Border>

            <TextBlock x:Name="HintText" Text="正在启动…"
                       FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"
                       HorizontalAlignment="Center" Margin="0,12,0,0" Opacity="0" />
        </StackPanel>
    </Grid>
</Window>
