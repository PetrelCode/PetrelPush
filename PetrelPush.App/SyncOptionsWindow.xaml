<Window x:Class="PetrelPush.App.SyncOptionsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="同步参数" Width="700" MaxHeight="660" SizeToContent="Height"
        MinWidth="560"
        WindowStartupLocation="CenterOwner"
        FontFamily="Microsoft YaHei UI, Segoe UI"
        FontSize="13"
        Foreground="{StaticResource TextPrimaryBrush}"
        Background="{StaticResource PageBackgroundBrush}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType">

    <!--
      与其它弹窗一致：内容直接铺在窗口底色上，不套 Card，也不重复标题栏里的标题；
      顶部只留一行说明，字段按 3 列 / 2 列网格排布。
    -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 滚动区不参与焦点：否则打开弹窗时它会先拿到焦点，画出一圈虚线框 -->
        <ScrollViewer Grid.Row="0" Margin="22,18,22,14" Focusable="False"
                      VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
                <TextBlock Text="只作用于当前连接；保存后立即重建该连接的引擎。"
                           Style="{StaticResource CardHint}" TextWrapping="Wrap" />

                <UniformGrid Columns="3" Margin="0,16,0,0">
                    <StackPanel Margin="0,0,12,12">
                        <TextBlock Text="去抖窗口 (ms)" Style="{StaticResource FieldLabel}" />
                        <TextBox x:Name="DebounceBox" />
                    </StackPanel>
                    <StackPanel Margin="0,0,12,12">
                        <TextBlock Text="强制触发上限 (ms)" Style="{StaticResource FieldLabel}" />
                        <TextBox x:Name="MaxForceBox" />
                    </StackPanel>
                    <StackPanel Margin="0,0,12,12">
                        <TextBlock Text="轮询间隔 (s)" Style="{StaticResource FieldLabel}" />
                        <TextBox x:Name="PollBox" />
                    </StackPanel>
                    <StackPanel Margin="0,0,12,12">
                        <TextBlock Text="深度校验 (天)" Style="{StaticResource FieldLabel}" />
                        <TextBox x:Name="DeepVerifyDaysBox" />
                    </StackPanel>
                    <StackPanel Margin="0,0,12,12">
                        <TextBlock Text="并发传输数" Style="{StaticResource FieldLabel}" />
                        <TextBox x:Name="ParallelBox" />
                    </StackPanel>
                    <StackPanel Margin="0,0,12,12">
                        <TextBlock Text="限速 (KB/s，0 不限)" Style="{StaticResource FieldLabel}" />
                        <TextBox x:Name="RateLimitBox" />
                    </StackPanel>
                    <StackPanel Margin="0,0,12,12">
                        <TextBlock Text="大文件阈值 (MB)" Style="{StaticResource FieldLabel}" />
                        <TextBox x:Name="LargeFileBox" />
                    </StackPanel>
                </UniformGrid>

                <TextBlock Text="可执行后缀（逗号分隔，上传后 chmod 755）" Style="{StaticResource FieldLabel}" />
                <TextBox x:Name="ExecutableSuffixesBox" Margin="0,0,0,16" />

                <UniformGrid Columns="2">
                    <CheckBox x:Name="SyncEmptyDirsCheck" Content="同步空目录" Margin="0,0,12,10" />
                    <CheckBox x:Name="DeleteEmptyDirsCheck" Content="清理远端空目录" Margin="0,0,12,10" />
                    <CheckBox x:Name="FollowSymlinksCheck" Content="跟随符号链接" Margin="0,0,12,10" />
                    <CheckBox x:Name="DryRunCheck" Content="dry-run（只计算不写入）" Margin="0,0,12,10" />
                </UniformGrid>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="1" Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource SoftBorderBrush}" BorderThickness="0,1,0,0"
                Padding="16,12">
            <DockPanel LastChildFill="False">
                <TextBlock x:Name="ResultText" DockPanel.Dock="Left" MaxWidth="380" FontSize="12"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           TextWrapping="Wrap" VerticalAlignment="Center" />
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Content="取消" Style="{StaticResource SecondaryButton}"
                            IsCancel="True" Margin="0,0,8,0" />
                    <Button Content="保存" Style="{StaticResource PrimaryButton}"
                            Click="OnSave" IsDefault="True" />
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</Window>
