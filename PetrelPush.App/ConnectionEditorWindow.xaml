<Window x:Class="PetrelPush.App.ConnectionEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="连接配置" Height="780" Width="740"
        MinHeight="520" MinWidth="620"
        WindowStartupLocation="CenterOwner"
        FontFamily="Microsoft YaHei UI, Segoe UI"
        FontSize="13"
        Foreground="{StaticResource TextPrimaryBrush}"
        Background="{StaticResource PageBackgroundBrush}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0" Margin="16,16,16,0"
                      VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
                <!-- 基本 -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="基本" Style="{StaticResource CardTitle}" Margin="0,0,0,10" />

                        <TextBlock Text="配置名称" Style="{StaticResource FieldLabel}" />
                        <TextBox x:Name="ProfileNameBox" Margin="0,0,0,12" />

                        <TextBlock Text="本地目录（Windows）" Style="{StaticResource FieldLabel}" />
                        <DockPanel Margin="0,0,0,12">
                            <Button DockPanel.Dock="Right" Content="浏览…" Width="76" Margin="8,0,0,0"
                                    Click="OnBrowseLocal" />
                            <TextBox x:Name="LocalRootBox" />
                        </DockPanel>

                        <TextBlock Text="远端目录（Linux 绝对路径，不存在会自动创建）" Style="{StaticResource FieldLabel}" />
                        <TextBox x:Name="RemoteRootBox" />
                    </StackPanel>
                </Border>

                <!-- 远端连接 -->
                <Border Style="{StaticResource Card}" Margin="0,12,0,0">
                    <StackPanel>
                        <TextBlock Text="远端连接（SSH / SFTP）" Style="{StaticResource CardTitle}" Margin="0,0,0,10" />

                        <WrapPanel>
                            <StackPanel Width="240" Margin="0,0,12,12">
                                <TextBlock Text="主机" Style="{StaticResource FieldLabel}" />
                                <TextBox x:Name="HostBox" />
                            </StackPanel>
                            <StackPanel Width="90" Margin="0,0,12,12">
                                <TextBlock Text="端口" Style="{StaticResource FieldLabel}" />
                                <TextBox x:Name="PortBox" />
                            </StackPanel>
                            <StackPanel Width="150" Margin="0,0,12,12">
                                <TextBlock Text="用户名" Style="{StaticResource FieldLabel}" />
                                <TextBox x:Name="UserBox" />
                            </StackPanel>
                            <StackPanel Width="150" Margin="0,0,0,12">
                                <TextBlock Text="认证方式" Style="{StaticResource FieldLabel}" />
                                <ComboBox x:Name="AuthTypeCombo" SelectedIndex="0" SelectionChanged="OnAuthTypeChanged">
                                    <ComboBoxItem Content="密码" />
                                    <ComboBoxItem Content="密钥" />
                                </ComboBox>
                            </StackPanel>
                        </WrapPanel>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,12,12">
                                <TextBlock Text="密码（DPAPI 加密保存）" Style="{StaticResource FieldLabel}" />
                                <PasswordBox x:Name="PasswordInput" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="0,0,0,12">
                                <TextBlock Text="私钥路径" Style="{StaticResource FieldLabel}" />
                                <DockPanel>
                                    <Button DockPanel.Dock="Right" Content="浏览…" Width="76" Margin="8,0,0,0"
                                            Click="OnBrowseKey" />
                                    <TextBox x:Name="PrivateKeyBox" />
                                </DockPanel>
                            </StackPanel>
                        </Grid>

                        <TextBlock x:Name="FingerprintText" Foreground="{StaticResource TextMutedBrush}"
                                   FontSize="12" TextWrapping="Wrap" Text="主机指纹：未确认" />
                    </StackPanel>
                </Border>

                <CheckBox x:Name="EnabledCheck" Margin="4,14,0,8"
                          Content="启用此连接（保存后立即启动同步）" />

                <TextBlock Margin="4,0,0,8" FontSize="12" TextWrapping="Wrap"
                           Foreground="{StaticResource TextMutedBrush}"
                           Text="同步参数（去抖、轮询、并发、限速、空目录等）用列表里该行的齿轮图标（悬停提示「同步参数」）单独调整，新建连接时使用默认值。" />
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="1" Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource SoftBorderBrush}" BorderThickness="0,1,0,0"
                Padding="16,12">
            <DockPanel LastChildFill="False">
                <TextBlock x:Name="ResultText" DockPanel.Dock="Left" MaxWidth="420" FontSize="12"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           TextWrapping="Wrap" VerticalAlignment="Center" />
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Content="测试连接" Style="{StaticResource SecondaryButton}"
                            Click="OnTestConnection" Margin="0,0,8,0" />
                    <Button Content="保存" Style="{StaticResource PrimaryButton}"
                            Click="OnSave" IsDefault="True" Margin="0,0,8,0" />
                    <Button Content="取消" Style="{StaticResource SecondaryButton}"
                            IsCancel="True" />
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</Window>
