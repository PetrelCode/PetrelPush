<Window x:Class="PetrelPush.App.ConnectionEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="连接配置" Width="740" MaxHeight="780" SizeToContent="Height"
        MinWidth="620"
        WindowStartupLocation="CenterOwner"
        FontFamily="Microsoft YaHei UI, Segoe UI"
        FontSize="13"
        Foreground="{StaticResource TextPrimaryBrush}"
        Background="{StaticResource PageBackgroundBrush}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType">

    <!--
      弹窗本身就是一块面板，内容直接铺在窗口底色上，不再套 Card：
      分组之间用一个区块标题 + 1px 分隔线区分，滚动时也不会出现"卡片里飘着卡片"的层次。
    -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 滚动区不参与焦点：否则打开弹窗时它会先拿到焦点，画出一圈虚线框 -->
        <ScrollViewer Grid.Row="0" Margin="22,18,22,14" Focusable="False"
                      VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
                <!-- 基本 -->
                <TextBlock Text="基本" Style="{StaticResource CardTitle}" />

                <!-- 名称与启停都是"这条连接是什么"级别的信息，并排各占一半 -->
                <Grid Margin="0,14,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="配置名称" Style="{StaticResource FieldLabel}" />
                        <TextBox x:Name="ProfileNameBox" />
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock Text="启用连接" Style="{StaticResource FieldLabel}" />
                        <CheckBox x:Name="EnabledCheck" Style="{StaticResource SwitchCheckBox}"
                                  Content="保存后立即启动同步"
                                  Height="34" VerticalContentAlignment="Center" />
                    </StackPanel>
                </Grid>

                <TextBlock Text="本地目录（Windows）" Style="{StaticResource FieldLabel}" />
                <DockPanel Margin="0,0,0,12">
                    <Button DockPanel.Dock="Right" Content="浏览…" Width="76" Margin="8,0,0,0"
                            Click="OnBrowseLocal" />
                    <TextBox x:Name="LocalRootBox" />
                </DockPanel>

                <TextBlock Text="远端目录（Linux 绝对路径，不存在会自动创建）" Style="{StaticResource FieldLabel}" />
                <TextBox x:Name="RemoteRootBox" />

                <Border Height="1" Background="{StaticResource SoftBorderBrush}" Margin="0,20,0,18" />

                <!-- 远端连接：指纹属于这台机器的身份信息，贴在区块标题右侧，不占正文一行 -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="远端连接（SSH / SFTP）"
                               Style="{StaticResource CardTitle}" VerticalAlignment="Center" />

                    <TextBlock x:Name="FingerprintText" Grid.Column="1" MaxWidth="360"
                               Foreground="{StaticResource TextMutedBrush}" FontSize="12"
                               TextWrapping="Wrap" TextAlignment="Right"
                               VerticalAlignment="Center" Text="主机指纹：未确认" />
                </Grid>

                <!-- 左右各一半：左边主机 + 端口，右边用户名 + 认证方式，与下方密码 / 私钥行对齐 -->
                <Grid Margin="0,14,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Grid Grid.Column="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="96" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="主机" Style="{StaticResource FieldLabel}" />
                            <TextBox x:Name="HostBox" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="端口" Style="{StaticResource FieldLabel}" />
                            <TextBox x:Name="PortBox" />
                        </StackPanel>
                    </Grid>

                    <Grid Grid.Column="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="150" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="用户名" Style="{StaticResource FieldLabel}" />
                            <TextBox x:Name="UserBox" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="认证方式" Style="{StaticResource FieldLabel}" />
                            <ComboBox x:Name="AuthTypeCombo" SelectedIndex="0"
                                      SelectionChanged="OnAuthTypeChanged">
                                <ComboBoxItem Content="密码" />
                                <ComboBoxItem Content="密钥" />
                            </ComboBox>
                        </StackPanel>
                    </Grid>
                </Grid>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,12,12">
                        <TextBlock Text="密码（DPAPI 加密保存）" Style="{StaticResource FieldLabel}" />
                        <PasswordBox x:Name="PasswordInput" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="0,0,0,12">
                        <TextBlock Text="私钥路径" Style="{StaticResource FieldLabel}" />
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Content="浏览…" Width="76" Margin="8,0,0,0"
                                    Click="OnBrowseKey" />
                            <TextBox x:Name="PrivateKeyBox" />
                        </DockPanel>
                    </StackPanel>
                </Grid>

            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="1" Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource SoftBorderBrush}" BorderThickness="0,1,0,0"
                Padding="16,12">
            <DockPanel LastChildFill="False">
                <TextBlock x:Name="ResultText" DockPanel.Dock="Left" MaxWidth="420" FontSize="12"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           TextWrapping="Wrap" VerticalAlignment="Center" />
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Content="测试连接" Style="{StaticResource SecondaryButton}"
                            Click="OnTestConnection" Margin="0,0,8,0" />
                    <Button Content="取消" Style="{StaticResource SecondaryButton}"
                            IsCancel="True" Margin="0,0,8,0" />
                    <Button Content="保存" Style="{StaticResource PrimaryButton}"
                            Click="OnSave" IsDefault="True" />
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</Window>
